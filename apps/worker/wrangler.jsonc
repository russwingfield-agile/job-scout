{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "job-scout",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job_scout_db",
      // PLACEHOLDER — replace with the real id from `wrangler d1 create` (see docs/RUNBOOK.md)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI", "remote": true },

  // Bindings below are part of the SPEC §13.1 target config but are NOT enabled yet: a deploy fails
  // if the resource does not exist, and nothing uses them before the milestone noted. Create the
  // resource (docs/RUNBOOK.md), uncomment, run `pnpm cf:types`, and log it in docs/DECISIONS.md.
  //
  // M4 — CV upload + embeddings:
  //   "r2_buckets": [{ "binding": "CVS", "bucket_name": "job-scout-cvs" }],
  //   "vectorize": [{ "binding": "VEC", "index_name": "job-scout-vectors", "remote": true }],
  //
  // M5 — ingest pipeline:
  //   "queues": {
  //     "producers": [
  //       { "binding": "FETCH_Q", "queue": "fetch-q" },
  //       { "binding": "PROCESS_Q", "queue": "process-q" },
  //       { "binding": "SCORE_Q", "queue": "score-q" }
  //     ],
  //     "consumers": [
  //       { "queue": "fetch-q", "max_batch_size": 5, "max_retries": 3, "dead_letter_queue": "job-scout-dlq" },
  //       { "queue": "process-q", "max_batch_size": 10, "max_retries": 3, "dead_letter_queue": "job-scout-dlq" },
  //       { "queue": "score-q", "max_batch_size": 3, "max_concurrency": 2, "max_retries": 3, "dead_letter_queue": "job-scout-dlq" }
  //     ]
  //   },
  "vars": { "TZ_NAME": "Europe/London", "DEV_BYPASS_AUTH": "false", "ENV": "production" }
}
